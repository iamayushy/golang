# Required: MongoDB connection string (local, Docker, or Atlas mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017

# Optional
MONGO_DB=urlshortener
# Public URL of the API, e.g. https://sortly.atlair.app (unset: taken from the request)
BASE_URL=http://localhost:8080
PORT=8080
# Public base used to build short_url in responses (no trailing slash)
BASE_URL=http://localhost:8080
# Public URL of the web frontend: / and expired links redirect here
FRONTEND_URL=http://localhost:3000
# Browser origins allowed to call the API (comma-separated). Defaults to FRONTEND_URL
ALLOWED_ORIGINS=http://localhost:3000
# Links one IP may create per minute (0 = unlimited)
RATE_LIMIT_PER_MIN=20
